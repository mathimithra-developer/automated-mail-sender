{
  "name": "mail-sender",
  "version": "1.0.0",
  "description": "Multi-tenant automated HTML email sender",
  "main": "backend/server.js",
  "type": "module",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "node --watch backend/server.js",
    "dev:react": "cd frontend-react && npm run dev",
