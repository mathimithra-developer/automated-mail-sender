    "seed": "node backend/seed.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1090.0",
    "@aws-sdk/client-ses": "^3.1092.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "country-state-city": "^3.2.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mongoose": "^8.15.1",
    "nodemailer": "^6.9.13"
  }
}
